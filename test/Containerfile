ARG PHP_VERSION=''

FROM docker.io/php:${PHP_VERSION}

# enable extensions used by phpunit
RUN apk add --no-cache oniguruma && \
    apk add --no-cache --virtual .mbstring-build-deps oniguruma-dev && \
    docker-php-ext-configure pcntl --enable-pcntl && \
    docker-php-ext-install mbstring pcntl && \
    apk del .mbstring-build-deps oniguruma-dev

COPY --from=composer/composer:2.2-bin /composer /usr/local/bin/composer

ENV COMPOSER_ALLOW_SUPERUSER=1
RUN case "${PHP_VERSION}" in 5.*|7.*) PHPUNIT_POLYFILLS_VERSION=2.0;; esac; \
    composer global require --dev yoast/phpunit-polyfills:"^${PHPUNIT_POLYFILLS_VERSION-"4.0"}"

CMD test/run.sh ${PHP_VERSION}
